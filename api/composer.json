{
    "name": "g7/api",
    "autoload": {
        "psr-4": {
            "": [
                "src/",
                "src/constantes",
                "src/tipos",
                "src/exception",
                "src/promocoes",
                "src/produtos",
                "src/carrinhos"
            ]
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "start": "php -S localhost:3000",
        "test": "kahlan",
        "dump": "composer dump-autoload",
        "analyze": "phpstan"
    },
    "require": {
        "phputil/router": "^0.3.6",
        "phputil/cors": "^0.5.3"
    },
    "require-dev": {
        "kahlan/kahlan": "^6.1",
        "phpstan/phpstan": "^2.1"
    }
}
